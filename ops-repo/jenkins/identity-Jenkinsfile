pipeline {
    agent any
    environment {
        DOCKER_HUB_USER = "circleguard"
        SERVICE_NAME = "identity-service"
        DOCKER_HUB_CREDENTIALS = "docker-hub-credentials"
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Build & Unit Tests (Dev)') {
            steps {
                echo "🚀 Levantando infraestructura temporal (Postgres)..."
        stage('Build & Unit Tests (Dev)') {
            steps {
                echo "🚀 Compilando y generando artefactos (Unit Tests)..."
                sh './gradlew :services:circleguard-identity-service:build -x test'
            }
        }
            }
        }
        stage('Docker Build') {
            steps {
                script {
                    echo "🔨 Construyendo imagen Docker localmente..."
                    sh "docker build -t ${DOCKER_HUB_USER}/${SERVICE_NAME}:${env.BUILD_ID} -t ${DOCKER_HUB_USER}/${SERVICE_NAME}:latest -f services/circleguard-identity-service/Dockerfile ."
                }
            }
        }
        stage('Deploy to Dev') {
            steps {
                echo "🚀 Desplegando en entorno de DESARROLLO (dev)..."
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh "kubectl create namespace dev --dry-run=client -o yaml | kubectl apply -f -"
                    sh "kubectl apply -f ops-repo/k8s/common-config.yaml --namespace dev"
                    sh "kubectl apply -f ops-repo/k8s/identity-deployment.yaml --namespace dev"
                    echo "🔍 Verificando despliegue en DEV..."
                    sh "kubectl rollout status deployment/${SERVICE_NAME} --namespace dev --timeout=90s"
                }
            }
        }
        stage('Deploy & Test (Stage)') {
            when { branch 'develop' }
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh "kubectl apply -f ops-repo/k8s/identity-deployment.yaml --namespace stage"
                }
                sh './gradlew :services:circleguard-identity-service:test'
            }
        }
        stage('Deploy to Prod (Master)') {
            when { branch 'main' }
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh "kubectl apply -f ops-repo/k8s/identity-deployment.yaml --namespace prod"
                }
            }
        }
        stage('Generate Release Notes') {
            when { branch 'main' }
            steps {
                sh 'chmod +x ops-repo/jenkins/scripts/generate-release-notes.sh'
                sh './ops-repo/jenkins/scripts/generate-release-notes.sh "CircleGuard Identity" ${env.BUILD_ID}'
                archiveArtifacts artifacts: 'ReleaseNotes-*.md'
            }
        }
    }
}
