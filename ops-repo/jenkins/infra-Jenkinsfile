pipeline {
    agent any
    environment {
        KUBECONFIG_CREDENTIALS = 'kubeconfig'
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Create Namespaces') {
            steps {
                echo "📦 Creando namespaces de Kubernetes..."
                withKubeConfig([credentialsId: "${KUBECONFIG_CREDENTIALS}"]) {
                    sh "kubectl --insecure-skip-tls-verify create namespace dev --dry-run=client -o yaml | kubectl --insecure-skip-tls-verify apply -f -"
                    sh "kubectl --insecure-skip-tls-verify create namespace stage --dry-run=client -o yaml | kubectl --insecure-skip-tls-verify apply -f -"
                    sh "kubectl --insecure-skip-tls-verify create namespace prod --dry-run=client -o yaml | kubectl --insecure-skip-tls-verify apply -f -"
                }
            }
        }

        stage('Deploy Infrastructure') {
            steps {
                echo "🏗️ Desplegando infraestructura (Postgres, Kafka, Redis, LDAP, Zookeeper)..."
                withKubeConfig([credentialsId: "${KUBECONFIG_CREDENTIALS}"]) {
                    sh "kubectl --insecure-skip-tls-verify apply -f ops-repo/k8s/infra-dev.yaml"
                    echo "⏳ Esperando a que Postgres esté listo..."
                    sh "kubectl --insecure-skip-tls-verify wait --for=condition=available deployment/circleguard-postgres --timeout=120s"
                }
            }
        }

        stage('Initialize Databases') {
            steps {
                echo "🗄️ Inicializando bases de datos de los microservicios..."
                withKubeConfig([credentialsId: "${KUBECONFIG_CREDENTIALS}"]) {
                    sh '''
                        # 1. Obtener nombre del Pod
                        POD=$(kubectl --insecure-skip-tls-verify get pod -l app=circleguard-postgres -o jsonpath='{.items[0].metadata.name}')
                        echo "🔍 Verificando Pod de Postgres: $POD"

                        # 2. Esperar a que Postgres acepte conexiones (máximo 60s)
                        echo "⏳ Esperando a que el motor de Postgres acepte conexiones..."
                        for i in {1..12}; do
                            if kubectl --insecure-skip-tls-verify exec $POD -- pg_isready -U admin -d postgres; then
                                echo "✅ Postgres está listo para recibir comandos."
                                break
                            fi
                            echo "... esperando 5s más ($i/12)"
                            sleep 5
                        done

                        # 3. Crear bases de datos de forma robusta
                        DATABASES="circleguard_auth circleguard_identity circleguard_promotion circleguard_dashboard circleguard_form"
                        for DB in $DATABASES; do
                            echo "⚙️ Procesando base de datos: $DB"
                            EXISTS=$(kubectl --insecure-skip-tls-verify exec $POD -- psql -U admin -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname='$DB'")
                            if [ "$EXISTS" = "1" ]; then
                                echo "   [SKIP] La base de datos '$DB' ya existe."
                            else
                                echo "   [CREATE] Creando base de datos '$DB'..."
                                kubectl --insecure-skip-tls-verify exec $POD -- psql -U admin -d postgres -c "CREATE DATABASE $DB;"
                            fi
                        done

                        echo "📊 Estado final de las bases de datos:"
                        kubectl --insecure-skip-tls-verify exec $POD -- psql -U admin -d postgres -c "\\l" | grep circleguard
                    '''
                }
            }
        }

        stage('Apply ConfigMaps') {
            steps {
                echo "⚙️ Aplicando configuración común a todos los namespaces..."
                withKubeConfig([credentialsId: "${KUBECONFIG_CREDENTIALS}"]) {
                    sh "kubectl --insecure-skip-tls-verify apply -f ops-repo/k8s/common-config.yaml --namespace dev"
                    sh "kubectl --insecure-skip-tls-verify apply -f ops-repo/k8s/common-config.yaml --namespace stage"
                    sh "kubectl --insecure-skip-tls-verify apply -f ops-repo/k8s/common-config.yaml --namespace prod"
                }
            }
        }

        stage('Verify Infrastructure') {
            steps {
                echo "🔍 Verificando estado de la infraestructura..."
                withKubeConfig([credentialsId: "${KUBECONFIG_CREDENTIALS}"]) {
                    sh "kubectl --insecure-skip-tls-verify get pods -n default"
                    sh "kubectl --insecure-skip-tls-verify get namespaces"
                    sh "kubectl --insecure-skip-tls-verify get configmaps -n dev"
                }
            }
        }
    }
    post {
        success {
            echo "✅ Infraestructura desplegada exitosamente. Namespaces y bases de datos listos."
        }
        failure {
            echo "❌ Error al desplegar la infraestructura. Revisar logs."
        }
    }
}
