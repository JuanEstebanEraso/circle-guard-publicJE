pipeline {
    agent any
    environment {
        DOCKER_HUB_USER = "circleguard"
        SERVICE_NAME = "auth-service"
        DOCKER_HUB_CREDENTIALS = "docker-hub-credentials"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        // Fase 1: Entorno DEV (Punto 2)
        stage('Build & Unit Tests (Dev)') {
            steps {
                script {
                    echo "🐳 Levantando Postgres usando Jenkins Docker DSL..."
                    docker.image('postgres:16').withRun('-e POSTGRES_PASSWORD=password -e POSTGRES_USER=admin -e POSTGRES_DB=circleguard -p 5432:5432') { pg ->
                        echo "⏳ Esperando a que Postgres esté listo..."
                        sh 'sleep 10'
                        echo "🚀 Ejecutando build y pruebas..."
                        sh './gradlew :services:circleguard-auth-service:build'
                    }
                }
            }
        }
        
        stage('Docker Build & Push') {
            steps {
                script {
                    docker.withRegistry("https://index.docker.io/v1/", "${DOCKER_HUB_CREDENTIALS}") {
                        def customImage = docker.build("${DOCKER_HUB_USER}/${SERVICE_NAME}:${env.BUILD_ID}", "-f services/circleguard-auth-service/Dockerfile .")
                        customImage.push()
                        customImage.push("latest")
                    }
                }
            }
        }

        stage('Deploy to Dev') {
            steps {
                echo "🚀 Desplegando en entorno de DESARROLLO (dev)..."
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh "kubectl create namespace dev --dry-run=client -o yaml | kubectl apply -f -"
                    sh "kubectl apply -f ops-repo/k8s/common-config.yaml --namespace dev"
                    sh "kubectl apply -f ops-repo/k8s/auth-deployment.yaml --namespace dev"
                    echo "🔍 Verificando despliegue en DEV..."
                    sh "kubectl rollout status deployment/${SERVICE_NAME} --namespace dev --timeout=90s"
                }
            }
        }
        
        // Fase 2: Entorno STAGE (Punto 4)
        stage('Deploy & Test (Stage)') {
            when {
                branch 'develop'
            }
            steps {
                echo "🚀 Desplegando en STAGE..."
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh "kubectl create namespace stage --dry-run=client -o yaml | kubectl apply -f -"
                    sh "kubectl apply -f ops-repo/k8s/auth-deployment.yaml --namespace stage"
                }
                // Aquí se ejecutarían las pruebas de integración
                sh './gradlew :services:circleguard-auth-service:test'
            }
        }

        // Fase 3: Entorno MASTER / PROD (Punto 5)
        stage('Deploy to Prod (Master)') {
            when {
                branch 'main'
            }
            steps {
                echo "🚀 Desplegando en PRODUCCIÓN..."
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh "kubectl create namespace prod --dry-run=client -o yaml | kubectl apply -f -"
                    sh "kubectl apply -f ops-repo/k8s/auth-deployment.yaml --namespace prod"
                }
            }
        }
        
        stage('Generate Release Notes') {
            when {
                branch 'main'
            }
            steps {
                echo "📝 Generando Release Notes..."
                sh 'chmod +x ops-repo/jenkins/scripts/generate-release-notes.sh'
                sh './ops-repo/jenkins/scripts/generate-release-notes.sh "CircleGuard Auth" ${env.BUILD_ID}'
                archiveArtifacts artifacts: 'ReleaseNotes-*.md', allowEmptyArchive: true
            }
        }
    }
}
