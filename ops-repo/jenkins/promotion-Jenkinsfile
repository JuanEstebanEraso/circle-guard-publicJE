pipeline {
    agent any
    environment {
        DOCKER_HUB_USER = "juanestebaneraso"
        SERVICE_NAME = "promotion-service"
        DOCKER_HUB_CREDENTIALS = "docker-hub-credentials"
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Build & Unit Tests (Dev)') {
            steps {
                echo "🚀 Compilando y generando artefactos (Unit Tests)..."
                sh './gradlew :services:circleguard-promotion-service:build -x test'
            }
        }
        }
        stage('Docker Build & Push') {
            steps {
                script {
                    docker.withRegistry("https://index.docker.io/v1/", "${DOCKER_HUB_CREDENTIALS}") {
                        def customImage = docker.build("${DOCKER_HUB_USER}/${SERVICE_NAME}:${env.BUILD_ID}", "-f services/circleguard-promotion-service/Dockerfile .")
                        customImage.push()
                        customImage.push("latest")
                    }
                }
            }
        }
        stage('Deploy to Dev') {
            steps {
                echo "🚀 Desplegando en entorno de DESARROLLO (dev)..."
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh "kubectl create namespace dev --dry-run=client -o yaml | kubectl apply -f -"
                    sh "kubectl apply -f ops-repo/k8s/common-config.yaml --namespace dev"
                    sh "kubectl apply -f ops-repo/k8s/promotion-deployment.yaml --namespace dev"
                    echo "🔍 Verificando despliegue en DEV..."
                    sh "kubectl rollout status deployment/${SERVICE_NAME} --namespace dev --timeout=90s"
                }
            }
        }
        stage('Deploy & Test (Stage)') {
            when { branch 'develop' }
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh "kubectl apply -f ops-repo/k8s/promotion-deployment.yaml --namespace stage"
                }
                sh './gradlew :services:circleguard-promotion-service:test'
            }
        }
        stage('Deploy to Prod (Master)') {
            when { branch 'main' }
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh "kubectl apply -f ops-repo/k8s/promotion-deployment.yaml --namespace prod"
                }
            }
        }
        stage('Generate Release Notes') {
            when { branch 'main' }
            steps {
                sh 'chmod +x ops-repo/jenkins/scripts/generate-release-notes.sh'
                sh './ops-repo/jenkins/scripts/generate-release-notes.sh "CircleGuard Promotion" ${env.BUILD_ID}'
                archiveArtifacts artifacts: 'ReleaseNotes-*.md'
            }
        }
    }
}
