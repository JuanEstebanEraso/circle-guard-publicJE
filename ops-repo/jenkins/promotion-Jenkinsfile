pipeline {
    agent any
    environment {
        DOCKER_HUB_USER = "juanestebaneraso"
        SERVICE_NAME = "promotion-service"
        DOCKER_HUB_CREDENTIALS = "docker-hub-credentials"
        TESTCONTAINERS_RYUK_DISABLED = "true"
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Compile (Dev)') {
            steps {
                echo "🚀 Compilando microservicio..."
                sh './gradlew :services:circleguard-promotion-service:bootJar --no-daemon -Dorg.gradle.jvmargs="-Xmx256m -XX:MaxMetaspaceSize=128m"'
            }
        }

        stage('Unit Tests (Dev)') {
            steps {
                echo "🧪 Ejecutando Pruebas Unitarias..."
                echo "SALTADO: Pruebas deshabilitadas para ahorrar memoria en el taller (Testcontainers usa >1GB RAM)"
            }
        }
        stage('Docker Build & Push') {
            steps {
                script {
                    docker.withRegistry("https://index.docker.io/v1/", "${DOCKER_HUB_CREDENTIALS}") {
                        def customImage = docker.build("${DOCKER_HUB_USER}/${SERVICE_NAME}:${env.BUILD_ID}-${env.BRANCH_NAME}", "-f services/circleguard-promotion-service/Dockerfile .")
                        customImage.push()
                        customImage.push("latest")
                    }
                }
            }
        }
        stage('Deploy to Dev') {
            steps {
                echo "🚀 Desplegando en entorno de DESARROLLO (dev)..."
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh "kubectl --insecure-skip-tls-verify create namespace dev --dry-run=client -o yaml | kubectl --insecure-skip-tls-verify apply -f -"
                    sh "kubectl --insecure-skip-tls-verify apply -f ops-repo/k8s/common-config.yaml --namespace dev"
                    sh "kubectl --insecure-skip-tls-verify apply -f ops-repo/k8s/promotion-deployment.yaml --namespace dev"
                    sh "kubectl --insecure-skip-tls-verify set image deployment/${SERVICE_NAME} ${SERVICE_NAME}=${DOCKER_HUB_USER}/${SERVICE_NAME}:${env.BUILD_ID}-${env.BRANCH_NAME} --namespace dev"
                    echo "🔍 Verificando despliegue en DEV..."
                    sh "kubectl --insecure-skip-tls-verify rollout status deployment/${SERVICE_NAME} --namespace dev --timeout=120s"
                }
            }
        }
        stage('Deploy & Test (Stage)') {
            when { branch 'develop' }
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh "kubectl --insecure-skip-tls-verify apply -f ops-repo/k8s/promotion-deployment.yaml --namespace stage"
                }
                sh './gradlew :services:circleguard-promotion-service:test'
            }
        }
        stage('Deploy to Prod (Master)') {
            when { branch 'master' }
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh "kubectl --insecure-skip-tls-verify apply -f ops-repo/k8s/promotion-deployment.yaml --namespace prod"
                }
            }
        }
        stage('Generate Release Notes') {
            when { branch 'master' }
            steps {
                sh 'chmod +x ops-repo/jenkins/scripts/generate-release-notes.sh'
                sh "./ops-repo/jenkins/scripts/generate-release-notes.sh \"CircleGuard Promotion\" ${env.BUILD_ID}-${env.BRANCH_NAME}"
                archiveArtifacts artifacts: 'ReleaseNotes-*.md'
            }
        }
    }
}


