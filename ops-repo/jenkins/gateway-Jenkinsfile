pipeline {
    agent any
    environment {
        DOCKER_HUB_USER = "juanestebaneraso"
        SERVICE_NAME = "gateway-service"
        DOCKER_HUB_CREDENTIALS = "docker-hub-credentials"
        TESTCONTAINERS_RYUK_DISABLED = "true"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        // Fase 1: Entorno DEV (Punto 2)
        stage('Compile (Dev)') {
            steps {
                echo "🚀 Compilando microservicio..."
                sh './gradlew :services:circleguard-gateway-service:classes --no-daemon'
            }
        }

        stage('Unit Tests (Dev)') {
            steps {
                echo "🧪 Ejecutando Pruebas Unitarias..."
                sh './gradlew :services:circleguard-gateway-service:test --no-daemon'
            }
        }
        
        stage('Docker Build & Push') {
            steps {
                script {
                    docker.withRegistry("https://index.docker.io/v1/", "${DOCKER_HUB_CREDENTIALS}") {
                        def customImage = docker.build("${DOCKER_HUB_USER}/${SERVICE_NAME}:${env.BUILD_ID}", "-f services/circleguard-gateway-service/Dockerfile .")
                        customImage.push()
                        customImage.push("latest")
                    }
                }
            }
        }

        stage('Deploy to Dev') {
            steps {
                echo "🚀 Desplegando en entorno de DESARROLLO (dev)..."
                withKubeConfig([credentialsId: 'kubeconfig', insecure: true]) {
                    sh "kubectl --insecure-skip-tls-verify create namespace dev --dry-run=client -o yaml | kubectl --insecure-skip-tls-verify apply -f -"
                    sh "kubectl --insecure-skip-tls-verify apply -f ops-repo/k8s/common-config.yaml --namespace dev"
                    sh "kubectl --insecure-skip-tls-verify apply -f ops-repo/k8s/gateway-deployment.yaml --namespace dev"
                    echo "🔍 Verificando despliegue en DEV..."
                    sh "kubectl --insecure-skip-tls-verify rollout status deployment/${SERVICE_NAME} --namespace dev --timeout=90s"
                }
            }
        }

        // Fase 2: Entorno STAGE (Punto 4)
        stage('Deploy & Test (Stage)') {
            when {
                // Solo se ejecuta si estamos en la rama 'develop' o 'release'
                branch 'develop'
            }
            steps {
                echo "🚀 Desplegando en STAGE y ejecutando pruebas de sistema..."
                withKubeConfig([credentialsId: 'kubeconfig', insecure: true]) {
                    sh "kubectl --insecure-skip-tls-verify create namespace stage --dry-run=client -o yaml | kubectl --insecure-skip-tls-verify apply -f -"
                    sh "kubectl --insecure-skip-tls-verify apply -f ops-repo/k8s/gateway-deployment.yaml --namespace stage"
                }
                // Aquí se ejecutarían las pruebas de integración en el entorno stage
                sh './gradlew :services:circleguard-gateway-service:test --tests "*IntegrationTest"'
            }
        }

        // Fase 3: Entorno MASTER / PROD (Punto 5)
        stage('Deploy to Prod (Master)') {
            when {
                // Solo se ejecuta si aprobamos un merge a 'main'
                branch 'main'
            }
            steps {
                echo "🚀 Desplegando en PRODUCCIÓN..."
                withKubeConfig([credentialsId: 'kubeconfig', insecure: true]) {
                    sh "kubectl --insecure-skip-tls-verify create namespace prod --dry-run=client -o yaml | kubectl --insecure-skip-tls-verify apply -f -"
                    sh "kubectl --insecure-skip-tls-verify apply -f ops-repo/k8s/gateway-deployment.yaml --namespace prod"
                }
            }
        }
        
        stage('Generate Release Notes') {
            when {
                branch 'main'
            }
            steps {
                echo "📝 Generando Release Notes..."
                sh 'chmod +x ops-repo/jenkins/scripts/generate-release-notes.sh'
                sh './ops-repo/jenkins/scripts/generate-release-notes.sh "CircleGuard Gateway" ${env.BUILD_ID}'
                // Aquí el archivo Markdown generado podría enviarse por email o subirse a un Wiki.
                archiveArtifacts artifacts: 'ReleaseNotes-*.md', allowEmptyArchive: true
            }
        }
    }
}

