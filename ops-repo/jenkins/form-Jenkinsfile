pipeline {
    agent any
    environment {
        DOCKER_HUB_USER = "circleguard"
        SERVICE_NAME = "form-service"
        DOCKER_HUB_CREDENTIALS = "docker-hub-credentials"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build & Unit Tests (Dev)') {
            steps {
        stage('Build & Unit Tests (Dev)') {
            steps {
                script {
                    def networkName = "cg-net-${env.BUILD_ID}"
                    echo "🌐 Creando red de Docker: ${networkName}"
                    sh "docker network create ${networkName}"
                    
                    try {
                        echo "🐳 Levantando servicios de soporte en la red..."
                        docker.image('postgres:16').withRun("--network ${networkName} --name db-form-${env.BUILD_ID} -e POSTGRES_PASSWORD=password -e POSTGRES_USER=admin -e POSTGRES_DB=circleguard") { pg ->
                            docker.image('redis:alpine').withRun("--network ${networkName} --name redis-form-${env.BUILD_ID}") { redis ->
                                
                                echo "⏳ Ejecutando Build dentro de un contenedor Gradle (en la misma red)..."
                                docker.image('gradle:8.14-jdk21-alpine').inside("--network ${networkName} -u root") {
                                    sh 'sleep 20' // Tiempo para que Postgres inicie
                                    sh "./gradlew :services:circleguard-form-service:build " +
                                       "-Dspring.datasource.url=jdbc:postgresql://db-form-${env.BUILD_ID}:5432/circleguard " +
                                       "-Dspring.data.redis.host=redis-form-${env.BUILD_ID} " +
                                       "-Dspring.kafka.bootstrap-servers=none" // Kafka lo validaremos en Stage
                                }
                            }
                        }
                    } finally {
                        echo "🧹 Eliminando red de Docker..."
                        sh "docker network rm ${networkName} || true"
                    }
                }
            }
        }
            }
        }
        stage('Docker Build & Push') {
            steps {
                script {
                    docker.withRegistry("https://index.docker.io/v1/", "${DOCKER_HUB_CREDENTIALS}") {
                        def customImage = docker.build("${DOCKER_HUB_USER}/${SERVICE_NAME}:${env.BUILD_ID}", "-f services/circleguard-form-service/Dockerfile .")
                        customImage.push()
                        customImage.push("latest")
                    }
                }
            }
        }
        stage('Deploy to Dev') {
            steps {
                echo "🚀 Desplegando en entorno de DESARROLLO (dev)..."
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh "kubectl create namespace dev --dry-run=client -o yaml | kubectl apply -f -"
                    sh "kubectl apply -f ops-repo/k8s/common-config.yaml --namespace dev"
                    sh "kubectl apply -f ops-repo/k8s/form-deployment.yaml --namespace dev"
                    echo "🔍 Verificando despliegue en DEV..."
                    sh "kubectl rollout status deployment/${SERVICE_NAME} --namespace dev --timeout=90s"
                }
            }
        }
        stage('Deploy & Test (Stage)') {
            when { branch 'develop' }
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh "kubectl apply -f ops-repo/k8s/form-deployment.yaml --namespace stage"
                }
                sh './gradlew :services:circleguard-form-service:test'
            }
        }
        stage('Deploy to Prod (Master)') {
            when { branch 'main' }
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh "kubectl apply -f ops-repo/k8s/form-deployment.yaml --namespace prod"
                }
            }
        }
        stage('Generate Release Notes') {
            when { branch 'main' }
            steps {
                sh 'chmod +x ops-repo/jenkins/scripts/generate-release-notes.sh'
                sh './ops-repo/jenkins/scripts/generate-release-notes.sh "CircleGuard Form" ${env.BUILD_ID}'
                archiveArtifacts artifacts: 'ReleaseNotes-*.md'
            }
        }
    }
}
